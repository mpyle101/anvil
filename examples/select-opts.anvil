# Variables are set via the binding operator: '>' 
[input: './data/jester.parquet'] > flights;

flights | [schema] | [print];

flights | [select:
  date=FL_DATE,
  time='AIR_TIME',
  dist:i64=DISTANCE,
  departure:f64='DEP_TIME',
  arrival=ARR_TIME,
  dec:decimal(10,2)=DISTANCE
] | [schema] | [print];