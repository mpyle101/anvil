# Select tools can be used to rename columns as well as
# pick them out of a data frame.
[input: './data/left.parquet'] | [select: id, first=first_name, last='last_name'] > L;

[join:
  L,
  ([input: './data/right.parquet'] | [select: email, title, id_r='id']),
  type='inner',
  cols_lt='id',
  cols_rt='id_r'
] 
| [drop: id_r]
| [print: 10];
